# =============================================================================
# CampusIQ - Environment Configuration (COPY THIS FILE TO .env)
# =============================================================================
# Never commit the real .env file. This file documents all required variables.

# ---- Application ----
APP_NAME=CampusIQ
APP_ENV=development                      # development | production
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
PORT=8000

# ---- Database ----
# Local development (default): SQLite needs no server.
DATABASE_URL=sqlite:///./campusiq.db
# Docker / production: PostgreSQL
# DATABASE_URL=postgresql+psycopg2://campusiq:campusiq@db:5432/campusiq
POSTGRES_USER=campusiq
POSTGRES_PASSWORD=campusiq
POSTGRES_DB=campusiq
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Auth / JWT ----
JWT_SECRET=change-me-to-a-long-random-hex-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SECURE_COOKIES=false                     # true in production (HTTPS)

# ---- Password hashing ----
PASSWORD_HASH_SCHEME=bcrypt              # bcrypt | argon2

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_AI=30/minute

# ---- File uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,ppt,pptx,xls,xlsx,txt,zip,png,jpg,jpeg,webp

# ---- Attendance policy ----
ATTENDANCE_THRESHOLD=75.0                # % required to be "safe"
ATTENDANCE_WARNING_MIN=65.0              # 65-74 => warning zone
ATTENDANCE_EDIT_WINDOW_HOURS=48          # faculty can edit attendance within this window

# ---- AI Assistant ----
# OpenAI-compatible provider. Leave blank to run in safe built-in "demo mode"
# (rule-based responder that uses the same permission-aware tools, no external calls).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai                       # openai | demo

# ---- CORS ----
# Add your deployed frontend URL (e.g., https://campusiq.onrender.com)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# ---- Render Deployment ----
# PostgreSQL connection string (Render provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/campusiq

# JWT secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production

# Set to false in production
DEBUG=false

# Frontend API URL (for production: https://your-backend.onrender.com/api)
VITE_API_URL=
